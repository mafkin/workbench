#!/usr/bin/env bash
# Start the Workbench service if it is not running, then open the app window.
#   bin/workbench                service + window
#   bin/workbench --no-window    service only
#   bin/workbench --install      run the service under systemd (starts at login, restarts on
#                                a crash, rebuilds and restarts after a git pull)
#   bin/workbench --uninstall    remove those units again
#   bin/workbench --print-units  show the units --install would write, changing nothing
#   bin/workbench --update       what the update unit runs after a pull
#   bin/workbench --migrate      move profiles still in YAML to wiki pages (part 11)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PORT="${WORKBENCH_PORT:-7420}"
URL="http://127.0.0.1:${PORT}/"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/workbench"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNITS=(workbench.service workbench-update.path workbench-update.service)

up() { curl -fsS -m 1 -H 'X-Workbench: 1' "${URL}api/health" >/dev/null 2>&1; }
installed() { [ -f "$UNIT_DIR/workbench.service" ]; }

# The units, with node and PATH as they are now: a login session's systemd may not
# see the PATH your shell has (nvm, ~/.local/bin for claude).
unit() {
  local node
  node="$(command -v node)"
  case "$1" in
    workbench.service) cat <<EOF
[Unit]
Description=Workbench service on 127.0.0.1:${PORT}

[Service]
Type=simple
WorkingDirectory=${ROOT}
Environment=PATH=${PATH}
ExecStart=${node} ${ROOT}/server/main.ts --port ${PORT}
Restart=on-failure
RestartSec=2
StandardOutput=append:${STATE_DIR}/server.log
StandardError=append:${STATE_DIR}/server.log

[Install]
WantedBy=default.target
EOF
    ;;
    workbench-update.path) cat <<EOF
[Unit]
Description=Rebuild and restart Workbench when its checkout moves (git pull)

[Path]
PathChanged=${ROOT}/.git/logs/HEAD

[Install]
WantedBy=default.target
EOF
    ;;
    workbench-update.service) cat <<EOF
[Unit]
Description=Rebuild and restart Workbench

[Service]
Type=oneshot
WorkingDirectory=${ROOT}
Environment=PATH=${PATH}
ExecStart=${ROOT}/bin/workbench --update
StandardOutput=append:${STATE_DIR}/update.log
StandardError=append:${STATE_DIR}/update.log
EOF
    ;;
  esac
}

case "${1:-}" in
  --migrate)
    exec node "$ROOT/server/migrate-cli.ts"
    ;;
  --print-units)
    for u in "${UNITS[@]}"; do
      echo "# ==> $UNIT_DIR/$u"
      unit "$u"
    done
    exit 0
    ;;
  --install)
    mkdir -p "$UNIT_DIR" "$STATE_DIR"
    for u in "${UNITS[@]}"; do unit "$u" >"$UNIT_DIR/$u"; done
    # A service started by hand would hold the port.
    if up && ! systemctl --user is-active --quiet workbench.service; then pkill -f -- "$ROOT/server/main.ts" || true; sleep 0.5; fi
    [ -f "$ROOT/dist/index.html" ] || (cd "$ROOT" && npx vite build --logLevel warn)
    systemctl --user daemon-reload
    systemctl --user enable --now workbench.service workbench-update.path
    echo "Installed: Workbench runs as a user service and rebuilds after a git pull."
    echo "Logs: $STATE_DIR/server.log and $STATE_DIR/update.log"
    exit 0
    ;;
  --uninstall)
    systemctl --user disable --now workbench-update.path workbench.service 2>/dev/null || true
    for u in "${UNITS[@]}"; do rm -f "$UNIT_DIR/$u"; done
    systemctl --user daemon-reload
    echo "Removed the Workbench user units."
    exit 0
    ;;
  --update)
    mkdir -p "$STATE_DIR"
    echo "== $(date -Is) update"
    cd "$ROOT"
    lock="$(sha256sum package-lock.json | cut -d' ' -f1)"
    if [ "$(cat "$STATE_DIR/lock.sha" 2>/dev/null || true)" != "$lock" ]; then
      npm ci
      echo "$lock" >"$STATE_DIR/lock.sha"
    fi
    npx vite build --logLevel warn
    systemctl --user restart workbench.service
    exit 0
    ;;
esac

if ! up; then
  mkdir -p "$STATE_DIR"
  if installed; then
    systemctl --user start workbench.service
  else
    if [ ! -f "$ROOT/dist/index.html" ]; then
      (cd "$ROOT" && npx vite build --logLevel warn) >>"$STATE_DIR/build.log" 2>&1
    fi
    nohup node "$ROOT/server/main.ts" --port "$PORT" >>"$STATE_DIR/server.log" 2>&1 &
  fi
  for _ in $(seq 50); do up && break; sleep 0.1; done
  if ! up; then
    msg="The service did not start; see $STATE_DIR/server.log"
    notify-send Workbench "$msg" 2>/dev/null || true
    echo "$msg" >&2
    exit 1
  fi
fi

[ "${1:-}" = "--no-window" ] && exit 0

# A GNOME Web app installed for this address gives a window without browser chrome.
for dir in "$HOME/.local/share/applications" "$HOME/.local/share/xdg-desktop-portal/applications"; do
  for f in "$dir"/org.gnome.Epiphany.WebApp_*.desktop; do
    if [ -f "$f" ] && grep -q "127.0.0.1:${PORT}" "$f"; then
      exec gtk-launch "$(basename "$f" .desktop)"
    fi
  done
done
exec xdg-open "$URL"
